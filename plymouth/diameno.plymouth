[Plymouth Theme]
Name=Diameno
Description=Framework 13 boot splash using the Diameno wallpaper and terminal palette
ModuleName=two-step

[two-step]
ImageDir=@THEME_DIR@
ScaleBackgroundImage=true
BackgroundStartColor=0x1c1c1c
BackgroundEndColor=0x1c1c1c
ProgressBarHorizontalAlignment=.5
ProgressBarVerticalAlignment=.66
ProgressBarWidth=720
ProgressBarHeight=10
ProgressBarBackgroundColor=0x444444
ProgressBarForegroundColor=0xa569a5
HorizontalAlignment=.5
VerticalAlignment=.49
DialogHorizontalAlignment=.5
DialogVerticalAlignment=.52
MessageBelowAnimation=true
Font=Maple Mono NF 20
TitleFont=Maple Mono NF 28
MonospaceFont=Maple Mono NF 12

[boot-up]
UseProgressBar=true
UseAnimation=true
UseEndAnimation=false

[shutdown]
UseProgressBar=true
UseAnimation=true
UseEndAnimation=false

[reboot]
UseProgressBar=true
UseAnimation=true
UseEndAnimation=false
